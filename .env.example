# Copy to .env.local and fill in. Everything is optional; features degrade gracefully.

# NeilAI chat (Google Gemini)
GEMINI_API_KEY=

# Contact form delivery via Resend (https://resend.com). Without these, messages are only logged.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be a sender on a domain verified in Resend; defaults to Resend's test sender.
CONTACT_FROM_EMAIL=

# Public origin used for metadata, sitemap.xml and robots.txt (auto-detected on Vercel).
NEXT_PUBLIC_SITE_URL=

# Optional: raises GitHub API rate limits for the home-page telemetry.
GITHUB_TOKEN=
