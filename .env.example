# Copy to .env.local and fill in. Everything is optional; features degrade gracefully.

# NeilAI chat (Google Gemini)
GEMINI_API_KEY=

# Contact form + photoshoot bookings via Resend (https://resend.com).
# In local dev without these, emails are printed to the terminal instead.
# On a live site without them the form shows an error rather than a fake "sent".
# Check a deployment at /api/contact → {"email": true} means it's wired up.
RESEND_API_KEY=
# Your inbox. With Resend's test sender this must be the email your Resend account uses.
CONTACT_TO_EMAIL=
# Optional: a sender on a domain verified in Resend, e.g. "Neil <hello@yourdomain.com>".
# When set, clients also get a confirmation email of their booking.
CONTACT_FROM_EMAIL=
# Optional: signs the Confirm / Suggest a date / Decline links in booking emails.
# Without it, a key derived from RESEND_API_KEY is used. Any long random string works.
BOOKING_SECRET=

# Public origin used for metadata, sitemap.xml and robots.txt (auto-detected on Vercel).
NEXT_PUBLIC_SITE_URL=

# Optional: raises GitHub API rate limits for the home-page telemetry.
GITHUB_TOKEN=

# Optional: the photography gallery on Cloudinary (see docs/PHOTOS.md).
# Cloudinary → Settings → API Keys → copy the "API environment variable".
# Without it the gallery uses the files in public/photography.
CLOUDINARY_URL=
